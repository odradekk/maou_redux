{
  "name": "ere-game",
  "version": "0.0.1",
  "private": true,
  "description": "ere game project (EraElectron)",
  "scripts": {
    "start": "node tools/engine-launch.mjs",
    "test": "node tools/run-node.mjs -- --test --test-concurrency=4",
    "test:ci": "node tools/run-node.mjs --timeout 1200 -- --test --test-concurrency=4 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=test-report.tap",
    "test:related": "node tools/run-node.mjs -- tools/select-tests.mjs --run",
    "test:inner": "node tools/run-node.mjs -- tools/select-tests.mjs --no-locks --run",
    "test:locks": "node tools/run-node.mjs -- tools/select-tests.mjs --locks-only --run",
    "test:select": "node tools/select-tests.mjs",
    "lint": "node tools/run-node.mjs -- node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format:check": "node tools/run-node.mjs -- node_modules/prettier/bin/prettier.cjs --check ."
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-require-sort": "^1.3.0",
    "eslint-plugin-sort-requires-by-path": "^1.0.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.4.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.13.1"
  }
}
