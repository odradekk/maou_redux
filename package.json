{
  "name": "ere-game",
  "version": "0.0.1",
  "private": true,
  "description": "ere game project (EraElectron)",
  "scripts": {
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=test-report.tap",
    "test:related": "node tools/select-tests.mjs --run",
    "test:inner": "node tools/select-tests.mjs --no-locks --run",
    "test:locks": "node tools/select-tests.mjs --locks-only --run",
    "test:select": "node tools/select-tests.mjs"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-require-sort": "^1.3.0",
    "eslint-plugin-sort-requires-by-path": "^1.0.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
