@換號
#DIM LV
#DIM CN,3
#DIMS CN_NAME,3
#DIM NO_PAGE = 0
#DIM L_LCOUNT
#DIM CONST NUM_PAGE = 25
$换号页
	CLEARLINE LINECOUNT
	PRINTFORML 交换角色的排序编号(PS:侵攻与迎击中的角色无法换号)
	PRINTFORML 请先选择要变换排序的角色
	FOR COUNT, NO_PAGE*NUM_PAGE + 1, (NO_PAGE+1)*NUM_PAGE +1
		IF COUNT >= CHARANUM
			PRINTL
			CONTINUE
		;对象是魔王剃除
		ELSEIF  COUNT == MASTER
			CONTINUE
		ENDIF	
		IF (CFLAG:COUNT:1 == 0 || CFLAG:COUNT:1 == 7) && (!EX_TALENT:COUNT:1 || (EX_TALENT:COUNT:2 && GETBIT(EX_FLAG:9000,1)))
			PRINTFORM [{COUNT,3,RIGHT}] %SAVESTR:COUNT,12,LEFT% %GET_JOB_NAME(COUNT),8,LEFT% LV:{CFLAG:COUNT:9,4,LEFT}
			IF SP(COUNT)
				SETCOLOR 0x00FFFF
				PRINTL [SP]
			ELSE
				PRINTL 
			ENDIF
		ENDIF	
		RESETCOLOR
	NEXT
		PRINTL
        PRINTL
		PRINTLC [2000] 上一页
		PRINTLC [2001] 下一页
        PRINTLC [1999] 結束换号
       INPUT
        SELECTCASE RESULT
        CASE 2000 ;上一页
			IF NO_PAGE > 0
				NO_PAGE --
				CLEARLINE LINECOUNT-L_LCOUNT
			ENDIF
			GOTO 换号页
        CASE 2001 ;下一页
			IF (NO_PAGE+1) * NUM_PAGE <= CHARANUM
				NO_PAGE ++
				CLEARLINE LINECOUNT-L_LCOUNT
			ENDIF
			GOTO 换号页
        CASE 1999
				JUMP CHARA_INFO
 			 ;BEGIN SHOP
        CASEELSE
			IF RESULT > 0 && RESULT <= CHARANUM
				CN:1 = RESULT
             ENDIF
		$换号页1
		CLEARLINE LINECOUNT
		PRINTFORML 要跟那个角色换号呢？
			FOR COUNT, NO_PAGE*NUM_PAGE + 1, (NO_PAGE+1)*NUM_PAGE +1
				IF COUNT >= CHARANUM
					PRINTL
					CONTINUE
				;对象是魔王剃除
				ELSEIF  COUNT == MASTER
					CONTINUE
				;对象是角色1剃除
				ELSEIF  COUNT == CN:1
					CONTINUE
				ENDIF	
				IF (CFLAG:COUNT:1 == 0 || CFLAG:COUNT:1 == 7) && (!EX_TALENT:COUNT:1 || (EX_TALENT:COUNT:2 && GETBIT(EX_FLAG:9000,1)))
					PRINTFORM [{COUNT,3,RIGHT}] %SAVESTR:COUNT,12,LEFT% %GET_JOB_NAME(COUNT),8,LEFT% LV:{CFLAG:COUNT:9,4,LEFT}
					IF SP(COUNT)
						SETCOLOR 0x00FFFF
						PRINTL [SP]
					ELSE
						PRINTL 
					ENDIF
				ENDIF	
				RESETCOLOR	
			NEXT
			PRINTL
			PRINTL
			PRINTLC [3000] 上一页
			PRINTLC [3001] 下一页
		INPUT
		SELECTCASE RESULT
			CASE 3000 ;上一页
				IF NO_PAGE > 0
				NO_PAGE --
				CLEARLINE LINECOUNT-L_LCOUNT
				ENDIF
				GOTO 换号页1
			CASE 3001 ;下一页
				IF (NO_PAGE+1) * NUM_PAGE <= CHARANUM
				NO_PAGE ++
				CLEARLINE LINECOUNT-L_LCOUNT
				ENDIF
				GOTO 换号页1
			CASEELSE
				IF RESULT > 0 && RESULT <= CHARANUM
					CN:2 = RESULT
				ENDIF
			ENDSELECT
        ENDSELECT
		PRINTL
		PRINTFORML %SAVESTR:(CN:1)%将与%SAVESTR:(CN:2)%交换排序编号，确定吗？
		PRINTLC [4000] 是
		PRINTLC [4001] 否
       INPUT
		IF	RESULT == 4000
			CN_NAME:1 = %SAVESTR:(CN:1)%
			CN_NAME:2 = %SAVESTR:(CN:2)%
			SWAPCHARA (CN:1), (CN:2)
			SAVESTR:(CN:1) =	%CN_NAME:2%
			SAVESTR:(CN:2) =	%CN_NAME:1%
			PRINTFORMW 已完成互换
			TARGET = -1
			ASSI = -1
			RESTART
		ELSEIF RESULT == 4001
			GOTO 换号页
			CN:1 = 0
			CN:2 = 0
		ELSE
		ENDIF
		RETURN 0



