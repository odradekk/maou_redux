PRINTLC [1001] - 下一页
PREV_PAGE = NO_PAGE

INPUT
IF RESULT == 1002
	;助手は無し
	ASSI = -1
	FLAG:2 = ASSI ;前回の助手を上書き
	RETURN 0
ELSEIF RESULT == 999
	;戻る
	RETURN 2
ELSEIF IS_ASSISTABLE(RESULT) == 0
	;助手可能な対象
	ASSI = RESULT
	FLAG:2 = ASSI ;前回の助手を上書き
	RETURN 1
ELSEIF RESULT == 1000		;上一页
	IF NO_PAGE > 0
		NO_PAGE --
		CLEARLINE LINECOUNT-L_LCOUNT
	ENDIF
	GOTO INPUT_LOOP
ELSEIF RESULT == 1001		;下一页
	IF NO_PAGE < MAX_PAGE
		NO_PAGE ++
		CLEARLINE LINECOUNT-L_LCOUNT
	ENDIF
	GOTO INPUT_LOOP
ELSEIF RESULT < 0 || RESULT >= CHARANUM
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
CLEARLINE 1
GOTO INPUT_LOOP



