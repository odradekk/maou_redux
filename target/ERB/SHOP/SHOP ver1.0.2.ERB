L_LCOUNT = LINECOUNT
CALL SHOW_LIST_ASSISTABLE(NO_PAGE,NUM_PAGE,LIST_POS)
;表示人数が返ってくる
IF RESULT < 1
	RETURN 0
ENDIF
L_LCOUNT = LINECOUNT - L_LCOUNT
	IF L_LCOUNT < (NUM_PAGE * 2 ) + 1
		REPEAT (NUM_PAGE * 2 - L_LCOUNT)
			PRINTL
		REND
	ENDIF
