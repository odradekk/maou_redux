;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
EX_FLAG:223 = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
EX_FLAG:223 = 0

;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;-------------------------------------------------
@EVENTTRAIN
SIF FLAG:7 <= 0
	RETURN 0
SIF EX_TALENT:223 != 1
	RETURN 0

;-------------------------------------------------
;初次调教时 CFLAG:201
;-------------------------------------------------
IF CFLAG:LOCAL:10 == 0
	DRAWLINE
	PRINTFORMW 口上测试
	CFLAG:201 = 1
	RETURN 1
ENDIF