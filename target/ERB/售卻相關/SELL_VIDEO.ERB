;撮影中のまま売却まで来た場合はテープの数を減らす
;テープの減数は撮影後処理のため
SIF TEQUIP:53
	ITEM:28 -= 1

;録画終了の分のカウントを削る
CFLAG:491 -= 1

;有効なビデオを録画してなければここで終了
SIF CFLAG:491 <= 0
	RETURN 0

